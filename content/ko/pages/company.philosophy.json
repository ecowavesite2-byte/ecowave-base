                          "html": "\n\t\t<div class=\"text_bg_color\" style=\"background-color: rgba(57, 112, 235, 0)\"></div><div class=\"text-table holder\"><div><p style=\"text-align:center;\"><span style=\"display: inline-flex; justify-content: center; align-items: center; width: 250px; aspect-ratio: 1 / 1; background-color: rgb(57, 112, 235); color: rgb(255, 255, 255); font-size: 30px; font-weight: bold; border-radius: 50%;\">Mission</span></p></div></div>\n\t"
