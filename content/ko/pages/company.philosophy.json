                          "html": "\n\t\t<div class=\"text_bg_color\" style=\"background-color: rgba(57, 112, 235, 0)\"></div><div class=\"text-table holder\"><div><p style=\"text-align:center;\"><span style=\"display:inline-flex;justify-content:center;align-items:center;width:250px;aspect-ratio:1/1;background-color:#3970eb;color:#fff;font-size:24px;font-weight:bold;border-radius:50%;\">건강한 약속</span></p></div></div>\n\t"
