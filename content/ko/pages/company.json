                          "html": "\n\t\t<div class=\"text-table \"><div><p style=\"line-height: 2; text-align: right;\"><span style=\"font-size: 18px;\">에코웨이브 대표</span><span style=\"font-size: 20px;\">&nbsp;&nbsp;<strong>최 태 국</strong></span></p></div></div>\n\t",
                          "anim": "fadeInUp",
