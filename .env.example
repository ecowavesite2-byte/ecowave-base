# ---------------------------------------------------------------------------
# ECOWAVE admin — environment configuration
#
# Copy to `.env.local` and fill in real values. Never commit credentials.
# `npm run build`/`next start` fail closed when auth vars are missing.
# ---------------------------------------------------------------------------

# iron-session signing + encryption secret. Must be at least 32 characters.
SESSION_SECRET=

# Email of the single admin account (compared case-insensitively).
ADMIN_EMAIL=

# scrypt password hash: 64-byte digest as lowercase hex (128 hex characters).
ADMIN_PASSWORD_HASH=

# scrypt salt as hex, used together with the password to derive the hash above.
ADMIN_PASSWORD_SALT=

# Postgres connection string — content override store + inquiry inbox.
# When unset, the site renders file-backed defaults and the contact form
# cannot persist (POST /api/inquiry returns 500).
# Use the POOLED URL here for the app; prisma.config.ts prefers a direct
# (unpooled) URL for `prisma migrate deploy` when one of the vars below is set.
DATABASE_URL=

# Optional: direct/unpooled Postgres URL for migrations (Neon provides
# DATABASE_URL_UNPOOLED automatically). Checked first by prisma.config.ts:
# DIRECT_URL_UNPOOLED -> DATABASE_URL_UNPOOLED -> DIRECT_URL.
# DIRECT_URL_UNPOOLED=

# Optional content data root for production writes (repo `content/` is the seed).
# CONTENT_ROOT=

# Legacy/unused: nothing reads this. Uploads go to Vercel Blob via
# `BLOB_READ_WRITE_TOKEN` below; there is no local media root or `/media/...` route.
# MEDIA_ROOT=

# Vercel Blob token for the content-editor image/video uploads. When unset the
# upload controls fail with a "Blob storage is not configured" notice.
BLOB_READ_WRITE_TOKEN=

# Login throttling (safe defaults: 5 failures / 15 minutes).
# ADMIN_LOGIN_MAX_FAILS=5
# ADMIN_LOGIN_WINDOW_MIN=15
