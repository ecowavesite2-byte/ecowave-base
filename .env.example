# ---------------------------------------------------------------------------
# ECOWAVE admin — environment configuration
#
# Copy to `.env.local` and fill in real values. Never commit credentials.
# `npm run build`/`next start` fail closed when auth vars are missing.
# ---------------------------------------------------------------------------

# iron-session signing + encryption secret. Must be at least 32 characters.
SESSION_SECRET=

# Email of the single admin account (compared case-insensitively).
ADMIN_EMAIL=

# scrypt password hash: 64-byte digest as lowercase hex (128 hex characters).
ADMIN_PASSWORD_HASH=

# scrypt salt as hex, used together with the password to derive the hash above.
ADMIN_PASSWORD_SALT=

# Optional content data root for production writes (repo `content/` is the seed).
# CONTENT_ROOT=
