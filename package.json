{
  "name": "ecowave",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.17 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev --port 4000",
    "build": "next build",
    "start": "next start --port 4517",
    "lint": "next lint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "content:validate": "node scripts/content-validate.mjs",
    "content:registry": "node scripts/gen-content-registry.mjs",
    "content:backup": "node scripts/content-backup.mjs",
    "content:restore": "node scripts/content-restore.mjs",
    "admin:set-password": "node scripts/admin-set-password.mjs",
    "verify": "npm run typecheck && npm run lint && npm run content:validate && npm run build"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@vercel/blob": "^2.8.0",
    "file-type": "^22.1.1",
    "iron-session": "^9.0.1",
    "next": "^15.5.4",
    "pg": "^8.23.0",
    "pretendard": "^1.3.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanitize-html": "^2.17.7",
    "write-file-atomic": "^7.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/sanitize-html": "^2.16.1",
    "@types/write-file-atomic": "^4.0.3",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.25",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.55.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.6",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1"
  }
}
